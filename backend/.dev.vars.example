# Local development secrets for `wrangler dev`.
# Copy to `.dev.vars` (gitignored) and edit. NEVER commit real values.
DEV_MODE = "1"
UPLOAD_TOKEN = "dev-upload-token-change-me"
ADMIN_SECRET = "dev-admin-secret-change-me"
# Leave unset locally — DEV_MODE=1 logs magic links instead of emailing.
# RESEND_API_KEY = ""
# REVENUECAT_WEBHOOK_SECRET = ""

# Stripe (test mode): from dashboard.stripe.com/test/apikeys + a webhook
# endpoint's signing secret (or `stripe listen --print-secret`).
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Web Push: run `node scripts/gen-vapid.mjs` and paste the two values.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_JWK=''
VAPID_SUBJECT="mailto:you@example.com"
